{
  "name": "Debouncify",
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "bump": "np --no-cleanup --no-publish",
    "test": "swift test --enable-swift-testing",
    "postversion": "replace-regex --from=\"\\d+\\.\\d+\\.\\d+\" --to=\"$npm_package_version\" README.md && git add README.md && git commit -m \"chore: bump\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "np": "^12.1.1",
    "replace-regex": "^0.0.4"
  },
  "funding": "https://github.com/sponsors/mesqueeb",
  "repository": {
    "type": "git",
    "url": "https://github.com/mesqueeb/Debouncify.git"
  },
  "homepage": "https://github.com/mesqueeb/Debouncify#readme",
  "bugs": "https://github.com/mesqueeb/Debouncify/issues",
  "packageManager": "pnpm@11.27.0"
}
